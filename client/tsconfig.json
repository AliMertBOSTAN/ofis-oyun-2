{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "jsx": "react",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "allowUmdGlobalAccess": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["react", "react-dom"]
  },
  "include": ["*.jsx"]
}
